// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Canal {
  whatsapp
  web
  email
  instagram
  facebook
  manual
  other
}

enum ReclamoEstado {
  pendiente
  en_proceso
  resuelto
  rechazado
  cerrado
}

enum ReclamoCategoria {
  agua_y_cloacas
  alumbrado
  baches_y_pavimento
  arbolado
  residuos
  electricidad
  gas
  transporte
  infraestructura
  otros
}

enum ReclamoPrioridad {
  alta
  media
  baja
}

enum MensajeOrigen {
  usuario
  asistente
}

model Reclamo {
  id            String           @id @default(uuid())
  correlationId String           @unique @map("correlation_id")
  contactKey    String           @map("contact_key")
  canal         Canal
  correo        String?
  dni           String?
  problema      String
  direccion     String
  lat           Float
  lng           Float
  categoria     ReclamoCategoria
  prioridad     ReclamoPrioridad
  estado        ReclamoEstado    @default(pendiente)
  observaciones String?
  metadata      Json?
  creadoEn      DateTime         @default(now()) @map("creado_en")
  actualizadoEn DateTime         @updatedAt @map("actualizado_en")
  resolvedAt    DateTime?        @map("resolved_at")

  mensajes      MensajeHistorial[]

  @@index([contactKey])
  @@index([estado])
  @@index([categoria])
  @@index([prioridad])
  @@index([creadoEn])
  @@map("reclamos")
}

model MensajeHistorial {
  id         String        @id @default(uuid())
  reclamoId  String        @map("reclamo_id")
  reclamo    Reclamo       @relation(fields: [reclamoId], references: [id], onDelete: Cascade)
  origen     MensajeOrigen
  texto      String
  creadoEn   DateTime      @default(now()) @map("creado_en")
  metadata   Json?

  @@index([reclamoId])
  @@map("mensajes_historial")
}
